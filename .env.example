# TECHNOLOPIA AI Platform — Environment Configuration
# انسخ هذا الملف باسم .env وضع فيه الإعدادات السرية الحقيقية

PORT=8080
HOST=0.0.0.0

# وضع العمل السحابي عديم الحالة (Stateless Container Mode for Cloud Run)
STATELESS_MODE=false
CRM_STAGING_NAMESPACE=staging
STAGING_FRONTEND_URL=https://tecnolobia-staging.web.app

# مفتاح التوقيع والتحقق الداخلي من التوكنات (JWT Secret - 256-bit entropy required in staging/prod)
JWT_SECRET=TECNOLOBIA_EXECUTIVE_SECURE_KEY_2026_COFOUNDERS_STAGING_KEY_32BYTES

# مفتاح تشفير توكنات GitHub بخوارزمية AES-256-GCM
GITHUB_ENCRYPTION_KEY=TECNOLOBIA_GITHUB_AES256_SECURE_KEY_2026

# نموذج الذكاء الاصطناعي الموحد في المنصة (Gemini 3.8 Flash)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# رموز أمان PIN / كلمات مرور الشريكين المؤسسين لتسجيل الدخول الآمن (تدعم النص المباشر أو التجزئة المملحة PBKDF2)
MOHAMED_PIN=your_mohamed_secure_pin_here
TAREK_PIN=your_tarek_secure_pin_here

# مفتاح Google AI Studio API الرسمي
# تنبيه مهم: اشتراك Gemini Pro الشخصي (Google One AI Premium) مخصص لاستخدام الويب (gemini.google.com)
# ولا يوفر استدعاءات API آلية للـ Backend.
# يجب استخراج API Key مستقل من منصة Google AI Studio الرسمية:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# توكنات GitHub للقراءة فقط (اختياري، يتم ضبطها عبر واجهة Projects Hub أيضاً)
# GITHUB_TOKEN_1=ghp_xxxx (لحساب م. محمد البحر)
# GITHUB_TOKEN_2=ghp_yyyy (لحساب م. طارق حافظ)

# ملاحظة أمنية صارمة:
# هذا الملف محمي ومدرج في .gitignore ولن يتم رفعه إلى المستودع العام نهائياً.
# في بيئة Google Cloud Run، يتم حقن هذه المتغيرات بشكل مشفر عبر Google Secret Manager.
